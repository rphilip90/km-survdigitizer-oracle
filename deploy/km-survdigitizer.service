[Unit]
Description=KM SurvdigitizeR Oracle FastAPI app
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/km-survdigitizer-oracle
EnvironmentFile=/opt/km-survdigitizer-oracle/.env
ExecStart=/opt/km-survdigitizer-oracle/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

